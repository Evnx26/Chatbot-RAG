# Salin ke .env lalu ganti semua nilai. File .env tidak boleh di-commit.
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=chatbot
# Password role app_user (role non-superuser yang dipakai FastAPI, tunduk pada RLS)
APP_DB_PASSWORD=change-me
# Port Postgres di host (untuk menjalankan pytest dari luar container)
DB_HOST_PORT=5433
# Minimal 32 karakter
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
# Dibuat oleh script seed (idempotent)
SEED_SUPER_ADMIN_EMAIL=superadmin@example.com
SEED_SUPER_ADMIN_PASSWORD=change-me
SEED_DEMO_ADMIN_EMAIL=admin@tokodemo.example
SEED_DEMO_ADMIN_PASSWORD=change-me
